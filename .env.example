# Образец файла секретов. Скопируй в {FACTORY_DATA_DIR}/.env и заполни.
# Права на боевой файл: chmod 600
#
# На Этапе 1 все провайдеры — заглушки, ни один ключ не нужен.
# Строки ниже понадобятся начиная с Этапа 2.

# --- пути и лимиты (у всех есть значения по умолчанию) ---
# FACTORY_DATA_DIR=/data
# FACTORY_TMP_DIR=/tmp/factory
# FACTORY_PROJECTS_DIR=/app/projects
# FACTORY_MAX_PARALLEL_IMAGES=1
# FACTORY_MAX_STEPS_PER_TICK=3
# FACTORY_TICK_INTERVAL_SEC=600
# FACTORY_LOCK_TTL_SEC=1800

# Только для разработки. При значении 1 посты публикуются в обход расписания,
# и тик пишет WARNING в лог на каждой итерации. В боевом конфиге быть не должно.
# FACTORY_IGNORE_SCHEDULE=0

# --- прокси ---
# HTTPS_PROXY=
# LLM_PROXY=
# IMAGE_PROXY=
# VK_PROXY=

# --- ключи (Этап 2 и дальше) ---
# VK_TOKEN_DEMO=
# LLM_BASE_URL=
# LLM_API_KEY=
# REPLICATE_TOKEN=
# TELEGRAM_BOT_TOKEN=
