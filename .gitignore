.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# состояние и секреты — никогда не в репозитории
.env
data/
tmp/
*.db
*.db-wal
*.db-shm

.DS_Store

# Боевые проекты. В них номер вашей группы, ваш чат в Telegram и настройки
# ниши — всё это личное, а репозиторий публичный. В нём остаётся только
# projects/demo как образец: там заглушки и нули вместо настоящих номеров.
#
# Как перенести боевой проект на другую машину — RUNBOOK.md → «Новая группа».
projects/*
!projects/demo/
!projects/demo/**

# Локальная песочница: своя база, свои секреты и свои проекты, чтобы опыты на
# ноутбуке не правили то, что уехало на малину.
data-local/

# Проекты для опытов. Отдельный каталог, а не подкаталог projects/, по двум
# причинам: бот отказывается работать, если проекты просят разные токены, и
# локальный воркер не должен даже видеть боевой конфиг.
projects-local/
