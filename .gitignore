.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# состояние и секреты — никогда не в репозитории
.env
data/
tmp/
*.db
*.db-wal
*.db-shm

.DS_Store

# Боевые проекты. В них номер вашей группы, ваш чат в Telegram и настройки
# ниши — всё это личное, а репозиторий публичный. В нём остаётся только
# projects/demo как образец: там заглушки и нули вместо настоящих номеров.
#
# Как перенести боевой проект на другую машину — RUNBOOK.md → «Новая группа».
projects/*
!projects/demo/
!projects/demo/**

# Локальная песочница: своя база, свои секреты и свои проекты, чтобы опыты на
# ноутбуке не правили то, что уехало на малину.
data-local/

# Отложенное: конфиги, которые сейчас не используются, но выбрасывать рано.
архив/

# Выгрузка из Claude Design: макеты, а не исходники. В репозиторий не едет —
# это входные данные для реализации, они меняются каждой итерацией дизайна.
design_handoff_content_factory_panel/

# Сборка фронта. Исходники в panel/src, готовые файлы — в
# factory/panel/static (они в репозитории: малина отдаёт их без Node).
panel/node_modules/
panel/.vite/
