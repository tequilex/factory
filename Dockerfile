# Образ контент-фабрики.
#
# Целевая машина — Raspberry Pi 3 с гигабайтом памяти, и это определяет всё
# остальное:
#
# * база `slim`, а не полная: на малине каждые сто мегабайт заметны;
# * **никакой сборки из исходников**. Pillow, pydantic и aiohttp публикуют
#   готовые колёса для aarch64, и ставиться должны именно они. Если сюда
#   попадёт пакет без колеса, установка потянет компилятор и займёт на малине
#   десятки минут — поэтому ниже стоит `--only-binary`, который в этом случае
#   честно упадёт при сборке, а не молча превратится в мучение;
# * система обязана быть 64-битной. На 32-битной ARM готовых колёс нет.
#
# Один образ на оба процесса: воркер и бот отличаются только командой запуска.
# Держать два почти одинаковых образа на карте памяти незачем.

FROM python:3.11-slim AS base

# PYTHONUNBUFFERED: логи должны попадать в journald сразу, а не когда буфер
# наполнится. Иначе «посмотри логи» в RUNBOOK показывает вчерашнее.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# Зависимости отдельным слоем: они меняются редко, а код — постоянно. Иначе
# каждая правка кода пересобирает всё, а на малине это минуты.
COPY pyproject.toml README.md ./
COPY factory ./factory

RUN pip install --only-binary=:all: --no-compile . \
    && find /usr/local -name '__pycache__' -type d -prune -exec rm -rf {} +

COPY migrations ./migrations

# Путь задан явно: внутри образа пакет ставится в site-packages, и умолчание
# «рядом с пакетом» указывает в пустоту. Проверено запуском собранного образа —
# без этой строки падает первая же команда.
ENV FACTORY_MIGRATIONS_DIR=/app/migrations

# Каталог данных монтируется томом. Пути по умолчанию именно такие — см.
# core/paths.py, там /data выбран как раз под контейнер.
VOLUME ["/data"]

# Своего пользователя в образе нет намеренно: он задаётся в compose номером
# владельца на хосте. Иначе файлы, созданные контейнером, принадлежат root — и
# после первого же обновления ключа ВК docker compose перестаёт читать файл
# секретов, а система не поднимается. Проверено на малине.

# Проверки здоровья здесь нет намеренно: образ один на два процесса, а
# проверять их надо по-разному. Хартбит пишет только воркер — для бота такая
# проверка означала бы вечный перезапуск. Проверка задана в compose, у той
# службы, к которой относится.

CMD ["factory", "run", "--loop"]
